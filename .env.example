# ==============================================================================
# MyTube Public Edition - Configuration Template
# ==============================================================================
# Non-sensitive settings belong in this file (.env).
# Sensitive credentials should be placed in ./deploy/secrets/ (Docker Compose secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Settings
# ------------------------------------------------------------------------------
# Port to expose on the host machine
PORT=5003

# Application environment (Production, Development)
ASPNETCORE_ENVIRONMENT=Production

# Path to persistent application data (SQLite database, keys, logs)
DATA_DIR=./data

# Path to host media library (scanned videos, music, thumbnails)
MEDIA_DIR=./media

# Path to torrent and direct download staging directory
DOWNLOADS_DIR=./media/downloads

# Comma-separated list of allowed web origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5003,http://127.0.0.1:5003

# ------------------------------------------------------------------------------
# 2. Optional Integrations (Feature Flags)
# ------------------------------------------------------------------------------
# Set to 'true' to launch Gluetun WireGuard VPN + Transmission torrent downloader
ENABLE_TORRENT=false

# Set to 'true' to launch Jellyfin media streaming server
ENABLE_JELLYFIN=false

# Set to 'true' to enable AI features (speech-to-text, summarization, Q&A)
ENABLE_AI=false

# ------------------------------------------------------------------------------
# 3. WireGuard VPN Configuration (Required only if ENABLE_TORRENT=true)
# ------------------------------------------------------------------------------
# VPN Provider (e.g. mullvad, protonvpn, ivpn, windscribe, airvpn, custom)
VPN_PROVIDER=custom

# WireGuard IP address assigned by your VPN provider (e.g., 10.2.0.2/32)
VPN_WIREGUARD_ADDRESSES=

# Note: Your WireGuard Private Key should be saved securely in:
# ./deploy/secrets/wireguard_private_key.txt (or export WIREGUARD_PRIVATE_KEY)

# ------------------------------------------------------------------------------
# 4. Optional Transmission Web UI Credentials
# ------------------------------------------------------------------------------
TRANSMISSION_USER=admin
TRANSMISSION_PASS=admin

# ------------------------------------------------------------------------------
# 5. Sensitive Credentials Reference
# ------------------------------------------------------------------------------
# The setup wizard automatically generates and stores sensitive secrets in
# ./deploy/secrets/ with restricted permissions:
#
#   ./deploy/secrets/jwt_secret.txt            (Required: 64-char JWT signing key)
#   ./deploy/secrets/encryption_key.txt        (32-byte AES data protection key)
#   ./deploy/secrets/gemini_api_key.txt        (Optional: Google Gemini API key)
#   ./deploy/secrets/groq_api_key.txt          (Optional: Groq Whisper/LLaMA key)
#   ./deploy/secrets/deepseek_api_key.txt      (Optional: DeepSeek API key)
#   ./deploy/secrets/wireguard_private_key.txt (Optional: WireGuard private key)
#
# Environment variable fallbacks (JWT_SECRET, GEMINI_API_KEY, GROQ_API_KEY, etc.)
# are supported if Docker Compose secrets cannot be used.

